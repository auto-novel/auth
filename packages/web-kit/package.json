{
  "name": "@novelia/web-kit",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "pnpm run typecheck",
    "dev": "vite playground",
    "build:playground": "pnpm run typecheck:playground && vite build playground",
    "typecheck:playground": "vue-tsc -b playground/tsconfig.json",
    "preview": "vite preview playground",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc -b"
  },
  "peerDependencies": {
    "@vicons/material": "^0.13.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "ky": "^2.1.0",
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.10"
  }
}
